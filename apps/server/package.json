{
  "name": "@repo/server",
  "version": "0.0.0",
  "main": "app.ts",
  "scripts": {
    "dev": "npm run env:load tsx watch src/infra/app.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:watch": "vitest --project e2e",
    "db:studio": "npm run env:load prisma studio",
    "db:migrate": "npm run env:load prisma migrate dev",
    "env:load": "dotenv -e ../../.env --",
    "build": "tsup",
    "start": "node dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "",
  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "@repo/tsconfig": "*",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.6.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.2",
    "@prisma/client": "^6.6.0",
    "@repo/env": "*",
    "@scalar/fastify-api-reference": "^1.29.3",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.13",
    "fastify": "^5.3.2",
    "fastify-type-provider-zod": "^4.0.2",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^3.24.3"
