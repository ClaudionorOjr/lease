// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  fullName  String    @map("full_name")
  email     String    @unique
  password  String
  phone     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  leases   Lease[]
  services Service[]

  @@map("users")
}

model Service {
  id           String  @id @default(uuid())
  name         String
  description  String?
  priceInCents Int     @map("price_in_cents")

  createdBy String @map("created_by")
  user      User   @relation(fields: [createdBy], references: [id])

  solicitations Solicitation[]
  leases        Lease[]

  @@map("services")
}

enum SolicitationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Solicitation {
  id          String             @id @default(uuid())
  lessee      String
  cpf         String
  email       String?
  phone       String
  description String?
  status      SolicitationStatus @default(PENDING)
  startDate   DateTime           @map("start_date")
  endDate     DateTime           @map("end_date")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime?          @updatedAt @map("updated_at")

  serviceId String?  @map("service_id")
  service   Service? @relation(fields: [serviceId], references: [id])
  leases    Lease[]

  @@index([status])
  @@index([startDate, endDate])
  @@map("solicitations")
}

model Lease {
  id                  String    @id @default(uuid())
  lessee              String
  cpf                 String
  email               String?
  phone               String
  description         String?
  startDate           DateTime  @map("start_date")
  endDate             DateTime  @map("end_date")
  leasingPriceInCents Int       @map("leasing_price_in_cents")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime? @updatedAt @map("updated_at")
  canceledAt          DateTime? @map("canceled_at")

  solicitationId String?       @map("solicitation_id")
  solicitation   Solicitation? @relation(fields: [solicitationId], references: [id])
  serviceId      String        @map("service_id")
  service        Service       @relation(fields: [serviceId], references: [id])
  createdBy      String        @map("created_by")
  user           User          @relation(fields: [createdBy], references: [id])

  @@index([startDate, endDate])
  @@map("leases")
}
